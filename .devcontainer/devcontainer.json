{
  "name": "Order reconciliation",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // The key arrives as an env var from a Codespaces secret, so it is never in
  // the repo and never reaches the browser. Set it once at
  // https://github.com/settings/codespaces
  "secrets": {
    "TYPESAFE_API_KEY": {
      "description": "TypeSafe API key. The server reads it; the browser never sees it.",
      "documentationUrl": "https://typesafe.ai"
    }
  },

  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && $HOME/.local/bin/uv sync",
  "postAttachCommand": "$HOME/.local/bin/uv run uvicorn app:app --host 0.0.0.0 --port 8100",

  "forwardPorts": [8100],
  "portsAttributes": {
    "8100": {
      "label": "Order reconciliation",
      "onAutoForward": "openPreview"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
